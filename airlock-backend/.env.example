# ---- Airlock backend configuration ----
PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/airlock

# JWT signing secret (min 32 chars recommended)
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# AES-256-GCM master key.
# Accepts: 64-char hex (32 raw bytes), 44-char base64 (32 raw bytes),
# or any passphrase (SHA-256 derived). Use hex/base64 in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=replace-me-with-64-hex-chars-or-a-strong-passphrase

# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# ---- Internal service-to-service authentication ----
# Optional. When set, /api/environments/:id/credentials requires the
# caller to present this value in the `X-Internal-Token` header. Only
# the MCP service should ever know it. Leave empty to disable the check
# (not recommended for production).
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_CREDENTIALS_TOKEN=