# ---- Node Airlock gateway (internal Docker DNS) ----
AIRLOCK_BASE_URL=http://airlock-app:3000
AIRLOCK_REQUEST_TIMEOUT=15

# ---- MCP server binding ----
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ---- Dry-run policy ----
# When true, every provider call is simulated regardless of credentials.
# Providers also auto-simulate when credentials are missing, masked, or
# start with "AKIA_TEST" (the E2E Postman test marker).
DRY_RUN=true

# ---- Optional AWS region default ----
AWS_DEFAULT_REGION=us-east-1
# Must match INTERNAL_CREDENTIALS_TOKEN in airlock-backend/.env
INTERNAL_CREDENTIALS_TOKEN=