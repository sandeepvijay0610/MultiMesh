# ---- Airlock Node backend (internal Docker DNS name) ----
AIRLOCK_BASE_URL=http://airlock-app:3000
AIRLOCK_REQUEST_TIMEOUT=15
# NO service token. The user's JWT is forwarded per-request from /invoke.

# ---- LLM (any OpenAI-compatible endpoint) ----
OPENAI_API_KEY=sk-replace-me
# Leave empty for api.openai.com, or point at Ollama / vLLM / Azure / etc.
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# ---- Checkpoint store ----
# WARNING: this file holds the user JWT inside each thread's state.
# Treat it as a secret: git-ignore it, back it up encrypted, never bake
# it into an image, and mount it on a persistent volume in production.
SQLITE_PATH=./data/checkpoints.sqlite

# ---- Server ----
HOST=0.0.0.0
PORT=8000